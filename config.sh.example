#!/usr/bin/env bash
# Copy to config.sh and fill in your values.
# config.sh is gitignored — never commit it.

export GCP_PROJECT="your-gcp-project-id"
export GCP_ZONE="us-east1-d"          # T4 available: us-east1-d, us-central1-a, us-west1-b

export INSTANCE_NAME="vscode-dev"
export MACHINE_TYPE="n1-standard-4"
export DISK_SIZE="100GB"
export DISK_TYPE="pd-ssd"

export IMAGE_FAMILY="pytorch-2-7-cu128-ubuntu-2404-nvidia-570"
export IMAGE_PROJECT="deeplearning-platform-release"

export FIREWALL_RULE_NAME="allow-ssh-development"
